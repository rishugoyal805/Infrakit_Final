<!DOCTYPE html>
<html>
<head><%- include('partials/head') %><title>InfraKit — Login</title></head>
<body class="bg-bg text-gray-200 flex items-center justify-center h-screen">
  <form method="POST" action="<%= basePath %>/login" class="bg-panel border border-border rounded-lg p-8 w-80">
    <h2 class="text-blue-500 font-bold text-xl mb-6">InfraKit</h2>
    <% if (error) { %><p class="text-red-400 text-sm mb-3"><%= error %></p><% } %>
    <input type="text" name="username" placeholder="Username" required
           class="w-full bg-bg border border-border rounded px-3 py-2 mb-3 text-sm focus:outline-none focus:border-blue-500">
    <input type="password" name="password" placeholder="Password" required
           class="w-full bg-bg border border-border rounded px-3 py-2 mb-4 text-sm focus:outline-none focus:border-blue-500">
    <button class="w-full bg-blue-600 hover:bg-blue-500 text-white rounded py-2 text-sm font-medium">Sign in</button>
  </form>
</body>
</html>