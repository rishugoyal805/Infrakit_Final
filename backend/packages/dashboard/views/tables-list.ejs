<!DOCTYPE html>
<html>
<head><%- include('partials/head') %><title>Tables — InfraKit</title></head>
<body class="bg-bg text-gray-200 flex">
  <%- include('partials/nav') %>
  <main class="flex-1 p-8">
    <h2 class="text-xl font-semibold mb-6">All Tables</h2>
    <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
      <% tables.forEach(function(t) { %>
        <a href="<%= basePath %>/tables/<%= t.name %>"
           class="block bg-panel border border-border rounded-lg p-4 hover:border-blue-500 transition">
          <div class="text-2xl mb-2"><%= t.icon %></div>
          <div class="font-medium"><%= t.label %></div>
          <div class="text-xs text-muted mt-1">
            <%= t.exists ? t.rowCount + ' rows' : 'not created yet' %>
          </div>
        </a>
      <% }); %>
    </div>
  </main>
</body>
</html>