<!DOCTYPE html>
<html>
<head><%- include('partials/head') %><title>InfraKit Dashboard</title></head>
<body class="bg-bg text-gray-200 flex">
  <%- include('partials/nav') %>

  <main class="flex-1 p-8 overflow-y-auto h-screen">
    <h2 class="text-xl font-semibold mb-6">Overview</h2>

    <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-5 gap-4 mb-8">
      <% packages.forEach(function(p) { %>
        <div class="bg-panel border border-border rounded-lg p-4">
          <h3 class="text-xs text-muted uppercase tracking-wide mb-1"><%= p.name %></h3>
          <div class="text-lg font-semibold">v<%= p.version %></div>
        </div>
      <% }); %>
    </div>

    <h3 class="text-sm font-semibold text-muted uppercase tracking-wide mb-2">Table rotation status</h3>
    <div class="bg-panel border border-border rounded-lg overflow-hidden mb-8">
      <table class="w-full text-sm">
        <thead class="bg-white/5 text-muted text-xs uppercase">
          <tr><th class="text-left px-4 py-2">Table</th><th class="text-left px-4 py-2">Rows</th><th class="text-left px-4 py-2">Threshold</th></tr>
        </thead>
        <tbody>
          <% rotation.forEach(function(t) { %>
            <tr class="border-t border-border">
              <td class="px-4 py-2"><a href="<%= basePath %>/tables/<%= t.table %>" class="text-blue-400 hover:underline"><%= t.table %></a></td>
              <td class="px-4 py-2"><%= t.rows %></td>
              <td class="px-4 py-2"><%= t.threshold %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>

    <h3 class="text-sm font-semibold text-muted uppercase tracking-wide mb-2">Blocked IPs</h3>
    <div class="bg-panel border border-border rounded-lg overflow-hidden mb-8">
      <table class="w-full text-sm">
        <thead class="bg-white/5 text-muted text-xs uppercase">
          <tr><th class="text-left px-4 py-2">IP</th><th class="text-left px-4 py-2">Reason</th><th class="text-left px-4 py-2">Blocked at</th><th></th></tr>
        </thead>
        <tbody>
          <% blockedIps.forEach(function(b) { %>
            <tr class="border-t border-border">
              <td class="px-4 py-2 font-mono"><%= b.ip %></td>
              <td class="px-4 py-2"><%= b.reason %></td>
              <td class="px-4 py-2 text-muted"><%= new Date(b.blocked_at).toLocaleString() %></td>
              <td class="px-4 py-2 text-right">
                <form method="POST" action="<%= basePath %>/unblock">
                  <input type="hidden" name="ip" value="<%= b.ip %>">
                  <button class="text-xs bg-blue-600 hover:bg-blue-500 text-white px-3 py-1 rounded">Unblock</button>
                </form>
              </td>
            </tr>
          <% }); %>
          <% if (blockedIps.length === 0) { %>
            <tr><td colspan="4" class="px-4 py-3 text-muted">No blocked IPs</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>

    <h3 class="text-sm font-semibold text-muted uppercase tracking-wide mb-2">Live events</h3>
    <div id="events" class="bg-panel border border-border rounded-lg p-3 h-72 overflow-y-auto font-mono text-xs"></div>
  </main>

  <script>
    const evtSource = new EventSource("<%= basePath %>/stream");
    const eventsDiv = document.getElementById("events");
    evtSource.addEventListener("event", (e) => {
      const data = JSON.parse(e.data);
      const line = document.createElement("div");
      line.className = "py-1 border-b border-border/50";
      line.textContent = `[${new Date(data.timestamp).toLocaleTimeString()}] ${data.name}: ${JSON.stringify(data.payload)}`;
      eventsDiv.prepend(line);
      while (eventsDiv.children.length > 50) eventsDiv.removeChild(eventsDiv.lastChild);
    });
  </script>
</body>
</html>