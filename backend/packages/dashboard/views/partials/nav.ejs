<aside class="w-56 shrink-0 bg-panel border-r border-border h-screen sticky top-0 flex flex-col">
  <div class="p-4 border-b border-border">
    <h1 class="text-blue-500 font-bold text-lg">InfraKit</h1>
  </div>
  <nav class="flex-1 overflow-y-auto py-2">
    <a href="<%= basePath %>/home"
       class="block px-4 py-2 text-sm text-gray-300 hover:bg-white/5 hover:text-white">
       Overview
    </a>
    <div class="px-4 pt-4 pb-1 text-xs text-muted uppercase tracking-wide">Tables</div>
    <% tables.forEach(function(t) { %>
      <a href="<%= basePath %>/tables/<%= t.name %>"
         class="flex items-center gap-2 px-4 py-2 text-sm text-gray-300 hover:bg-white/5 hover:text-white">
        <span><%= t.icon %></span>
        <span><%= t.label %></span>
      </a>
    <% }); %>
  </nav>
  <div class="p-4 border-t border-border">
    <a href="<%= basePath %>/logout" class="text-xs text-muted hover:text-red-400">Log out</a>
  </div>
</aside>