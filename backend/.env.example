# Platform backend config
PORT=4000

# Used to sign the PLATFORM's own login sessions (email+password auth) — different from
# the per-project secrets used for the exported dashboard-auth middleware.
PLATFORM_JWT_SECRET=replace-with-a-long-random-string

# Public origin of this platform, used in generated export files
PLATFORM_ORIGIN=http://localhost:4000

# The frontend's own origin, for CORS. Only matters cross-origin — the Vite
# dev proxy makes local dev same-origin already, so this is mainly for prod.
FRONTEND_ORIGIN=http://localhost:5173

DB_PATH=./data/platform.db
